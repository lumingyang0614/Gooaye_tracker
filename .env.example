APP_NAME=Gooaye Tracker
APP_ENV=development

# 獨立的新資料庫，不與 Serenity Stock Tracker 共用同一個 database。
POSTGRES_DSN=postgresql+psycopg://帳號:密碼@localhost:5432/gooaye_tracker

# 選用：X Stock Tracker（E:\X_stock_tracker）的資料庫。留空則整個整合都會自動略過。
# 這條連線有兩個用途：
#   1. 讀取多市場證券主檔（台／美／日／韓公司名稱與代號對照），把 LLM 抽取出的
#      公司名稱還原成正確代號。只需要對這四張表有唯讀權限：
#      taiwan_securities / us_securities / japan_securities / korea_securities。
#   2. 把 Gooaye 算出來的公司觀點以 source='gooaye' 寫進 x_company_views，
#      讓 X Stock Tracker 的儀表板能把股癌的看法跟 X 貼文的看法並排比較。
#      這需要對 x_company_views 有 SELECT/INSERT/UPDATE/DELETE 權限——在
#      E:\X_stock_tracker 執行一次 `python -m scripts.migrate_company_view_source`
#      就會自動授權，其餘資料表（含 x_articles）維持沒有權限。
# 只想要用途 1 的話，把 config/settings.yaml 的 xstocktracker.push_company_insights
# 設成 false 即可，此時唯讀帳號就夠用。
XSTOCKTRACKER_DB_URL=

# LLM_PROVIDER 可選 ollama（本機，預設）／bai／api（任何相容 OpenAI Chat Completions 格式的服務）。
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:30b
LLM_TIMEOUT_SECONDS=300

# 若 LLM_PROVIDER=bai：與 Serenity Stock Tracker 相同的 BAI 服務設定，可沿用同一組金鑰。
BAI_API_URL=https://api.b.ai/v1
BAI_API_KEY=
BAI_API_MODEL=glm-5.3-flash

# 若 LLM_PROVIDER=api，改用其他相容 OpenAI 格式的雲端服務。
LLM_API_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_API_MODEL=

# faster-whisper 本機語音轉文字設定（僅用來補逐字稿站尚未收錄的最新集數）。
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
